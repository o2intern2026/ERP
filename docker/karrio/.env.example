# Copy to docker/karrio/.env (git-ignored) and fill the three secrets before `docker compose up`.
KARRIO_TAG=2026.1.32
KARRIO_HTTP_PORT=5002
KARRIO_PUBLIC_URL=http://localhost:5002
DASHBOARD_PORT=3002
DASHBOARD_URL=http://localhost:3002
ALLOWED_HOSTS=localhost,127.0.0.1,api

# Random strings, 32+ characters each (e.g. `openssl rand -hex 32`). Local only.
SECRET_KEY=
JWT_SECRET=

# First-start admin login for the dashboard. Choose your own password; Karrio's documented default is "demo".
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

DATABASE_PASSWORD=postgres
