APP_NAME="Logistics ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Australia/Melbourne

APP_LOCALE=zh
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_AU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 only — never SQLite (ERP_PLAN §8.1). Local DB account comes from the team vault; never commit .env.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erp
DB_USERNAME=erp_user
DB_PASSWORD=change_me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue: database driver, drained by cron `queue:work --stop-when-empty` in production (local: `queue:listen`).
# The queue table is `queue_jobs` because `jobs` is the business Job table (contracts/db-schema.md).
QUEUE_CONNECTION=database
# PDF_CJK_FONT=/absolute/path/inside/the/project/cjk.ttf   # CJK TrueType font for Chinese PDFs (default storage/fonts/cjk.ttf)
DB_QUEUE_TABLE=queue_jobs

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="erp@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# true = bind app/Support/Fakes implementations of contracts/services.md instead of module implementations.
USE_FAKE_SERVICES=false

# Carrier gateways (keys live in the team vault; leave empty to use the manual / own-fleet paths only)
KARRIO_BASE_URL=http://localhost:5002
KARRIO_API_KEY=
KARRIO_CARRIER_IDS=
TRANSDIRECT_BASE_URL=https://www.transdirect.com.au/api
TRANSDIRECT_API_KEY=
