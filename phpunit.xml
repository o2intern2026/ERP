<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- The 入库单 PDF embeds a CJK TrueType font when storage/fonts/cjk.ttf exists; php-font-lib parses it in memory (~65 MB per render) on top of a ~110 MB test process (CHANGE_REQUESTS #90). -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="erp_test"/>
        <!-- Carrier gateways: tests never talk to a real Karrio / Transdirect even when the developer's .env has keys -->
        <env name="KARRIO_API_KEY" value=""/>
        <env name="KARRIO_BASE_URL" value="http://karrio.test:5002"/>
        <env name="KARRIO_CARRIER_IDS" value=""/>
        <env name="KARRIO_LIVE" value=""/>
        <env name="TRANSDIRECT_API_KEY" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="USE_FAKE_SERVICES" value="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
